!.env.example

# 公開データの元ファイル（取り込みスクリプトで取り直せる）
data/raw/

# コミット前フックで探す、手元だけの秘密の文字列
.claude/secret-patterns.local

# Claude Code の個人設定
.claude/settings.local.json

# 教員モードの下書き（承認する前のステージ。公開しない）
.drafts/
