# 教員モード（npm run teacher）だけが使う API キーの見本。値は書いていない。
# このファイルを .env という名前でコピーして、= の右に自分のキーを書く。
# .env は .gitignore に入っているのでコミットされない。リポジトリの外に置くなら、環境変数 TEACHER_ENV_FILE でその場所を指定する。
# 学生用の公開サイト（GitHub Pages）は、このキーを使わない。
ANTHROPIC_API_KEY=

# 任意：教員モードのサーバーのポート（既定は 8787。127.0.0.1 だけで待ち受ける）
# TEACHER_PORT=8787
