{
  "name": "sentakuatsu",
  "version": "0.1.0",
  "private": true,
  "description": "センタクアツ：抗菌薬の選び方が未来の耐性菌をつくることを体感する、教育用タワーディフェンス",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:fetch": "tsx scripts/data/fetch-raw.ts",
    "data:build": "tsx scripts/data/build-data.ts",
    "sim": "tsx scripts/sim.ts",
    "data:verify": "tsx scripts/data/verify-data.ts",
    "teacher": "tsx server/teacher.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "1.5.6",
    "exceljs": "^4.4.0",
    "qrcode": "1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@fontsource/dotgothic16": "5.3.1",
    "phaser": "3.90.0"
  }
}
